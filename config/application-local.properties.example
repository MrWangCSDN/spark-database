# 将本文件复制为 application-local.properties 后部署。也可以直接使用原工程的
# application-datasource.properties、application-executor.properties、application-spark.properties。
# 原配置的 primary 名称 frw 与数据库字段都不用改；下方仅用环境变量替代生产凭据。
spring.datasource.dynamic.primary=frw
spring.datasource.dynamic.datasource.frw.url=${TSS_METADATA_URL}
spring.datasource.dynamic.datasource.frw.username=${TSS_METADATA_USER}
spring.datasource.dynamic.datasource.frw.password=${TSS_METADATA_PASSWORD}
spring.datasource.dynamic.datasource.frw.driver-class-name=${TSS_METADATA_DRIVER}

# Jasypt 3.0.5。密钥从进程环境变量 JASYPT_ENCRYPTOR_PASSWORD 注入，不写入本文件。
jasypt.encryptor.algorithm=PBEWITHHMACSHA512ANDAES_256
jasypt.encryptor.key-obtention-iterations=1000
jasypt.encryptor.salt-generator-classname=org.jasypt.salt.RandomSaltGenerator
jasypt.encryptor.iv-generator-classname=org.jasypt.iv.RandomIvGenerator
jasypt.encryptor.string-output-type=base64

# 服务任务库和 Spark 结果库必须是同一逻辑库，且 Spark 各节点都能访问。
spark.datasource.url=${spring.datasource.dynamic.datasource.frw.url}
spark.datasource.username=${spring.datasource.dynamic.datasource.frw.username}
spark.datasource.password=${spring.datasource.dynamic.datasource.frw.password}
spark.datasource.driver-class-name=${spring.datasource.dynamic.datasource.frw.driver-class-name}
spark.datasource.batchExecute=1000

spark_home=${SPARK_HOME}
spark.master.path=${SPARK_MASTER}
spark_mainClass=cn.sunline.tss.tssveri.spark.SparkHandlerTable
app_resource=${COMPARE_HOME}/jobs/compare-spark-1.0.0-SNAPSHOT.jar
# 由 bin/start.sh 自动枚举 drivers/*.jar；也可填写逗号分隔的驱动绝对路径。
compare.spark-jars=${COMPARE_SPARK_JARS:}
spark.submit.deployMode=client
spark.log.flag=${SPARK_LOG_FLAG:true}
# 如运行在 YARN，配置原 hadoop_conf_dir。
# hadoop_conf_dir=/opt/hadoop/etc/hadoop

# 以下资源值来自原 application-spark.properties，并非容量建议。
spark.cores.max=${SPARK_CORES_MAX:4}
spark.executor.cores=${SPARK_EXECUTOR_CORES:2}
spark.executor.memory=${SPARK_EXECUTOR_MEMORY:2g}
spark.executor.memoryOverhead=${SPARK_EXECUTOR_MEMORY_OVERHEAD:2g}
spark.executor.instances=${SPARK_EXECUTOR_INSTANCES:2}
spark.default.parallelism=${SPARK_DEFAULT_PARALLELISM:100}
spark.driver.maxResultSize=${SPARK_DRIVER_MAX_RESULT_SIZE:1g}
spark.sql.shuffle.partitions=${SPARK_SQL_SHUFFLE_PARTITIONS:2000}
spark.driver.memory=${SPARK_DRIVER_MEMORY:1g}
spark.network.timeout=${SPARK_NETWORK_TIMEOUT:300}
# 序列化 RDD 缓存压缩，减少完整分组缓存的内存与落盘体积。
spark.rdd.compress=${SPARK_RDD_COMPRESS:true}
# 可选本地目录，支持逗号分隔的多目录。请填写运行节点的实际大磁盘路径。
# spark.local.dir=/data/spark-local
# Standalone Executor 使用各 Worker 的本地目录，请同步配置 Worker 的 SPARK_LOCAL_DIRS。

tssveritask.executor.thread.enable=${BD_TASKS_ENABLED:true}
tssveritask.executor.thread.maxPoolSize=${BD_TASK_CONCURRENCY:1}
tssveritask.executor.thread.awaitTerminationSeconds=60
compare.poll-interval-ms=2000
compare.refresh-timeout-seconds=300
compare.jdbc-query-timeout-seconds=30
# 管理台“测试连接”的单次超时与服务实例并发上限；测试不执行用户 SQL。
compare.database-test-timeout-seconds=10
compare.database-test-max-concurrency=4
# 0表示不限制作业运行时间，符合原来一直等待的行为。
compare.spark-timeout-seconds=0
server.port=${SERVER_PORT:8899}

# Metadata control-plane dialect: GAUSSDB (default) or GDB.
bd.metadata-db-type=${BD_METADATA_DB_TYPE:GAUSSDB}
spark.gdb.jdbc-url-prefixes=${SPARK_GDB_JDBC_URL_PREFIXES:jdbc:mysql:,jdbc:gdb:,jdbc:gbase:}

# 按配置字段英文名匹配 SQL 返回列名或别名，false 使用历史位置映射。
compare.field-match-by-name=${BD_FIELD_MATCH_BY_NAME:true}
