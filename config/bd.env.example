# 部署至 /home/ccbs/bd/config/bd.env；启动前修改以下占位配置。
# 由 bin/start.sh 自动加载。值建议使用单引号，密码中如有单引号需按 Bash 语法转义。

# 使用 JDK 17；已在 PATH 配置好 JDK 17 时无需设置 JAVA_HOME。
# JAVA_HOME='/opt/jdk-17'

# bd 元数据库：服务和 Spark 使用同一逻辑库、同一 schema。
TSS_METADATA_URL='jdbc:postgresql://CHANGE_ME:5432/CHANGE_ME?currentSchema=CHANGE_ME'
TSS_METADATA_USER='CHANGE_ME'
# 使用 bin/encrypt-password.sh 生成 ENC(...)；加密口令由外部环境注入 JASYPT_ENCRYPTOR_PASSWORD。
TSS_METADATA_PASSWORD='ENC(CHANGE_ME)'
TSS_METADATA_DRIVER='org.postgresql.Driver'

# Spark 3.5.3 安装路径与集群地址，按内网实际环境修改。
SPARK_HOME='/opt/spark-3.5.3'
SPARK_MASTER='spark://CHANGE_ME:7077'

SERVER_PORT=8899
# 可选 JVM 参数；作用于继承本环境的 Java 进程。
# JAVA_TOOL_OPTIONS='-Xms512m -Xmx2g'
# JDBC 驱动默认从 drivers/ 自动扫描，无需手动填写 COMPARE_SPARK_JARS。
# Spark 资源配置与任务并发数请在 config/application-local.properties 中调整。

# 启停控制：start.sh 等待启动日志，stop.sh 等待优雅退出。
BD_START_WAIT_SECONDS=30
BD_STOP_TIMEOUT_SECONDS=120

# 每张表、每个核对业务日期、每种字段差异组合的样本上限（0只存汇总，最大10000）；仅一侧存在也各使用此上限
BD_DIFF_DETAIL_LIMIT=100
# 新版样本保留天数，按最近成功发布时间；汇总长期保留
BD_DIFF_RETENTION_DAYS=30

# Control-plane database type: GAUSSDB (default) or GDB.
BD_METADATA_DB_TYPE='GAUSSDB'
# For GDB use the vendor MySQL-compatible driver supplied in drivers/.
# TSS_METADATA_URL='jdbc:mysql://gdb-host:3306/tss_compare?useUnicode=true&characterEncoding=UTF-8&useSSL=false'
# TSS_METADATA_DRIVER='com.mysql.jdbc.Driver'
# Spark accepts jdbc:mysql: by default; append vendor prefixes when needed.
SPARK_GDB_JDBC_URL_PREFIXES='jdbc:mysql:,jdbc:gdb:,jdbc:gbase:'

# 默认按 SQL 列名/AS 别名匹配字段；false 使用历史字段位置。
BD_FIELD_MATCH_BY_NAME=true
